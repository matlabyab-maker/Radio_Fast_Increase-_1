<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rootLayout"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="#FCE4EC" android:padding="6dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:text="Fast Radio" android:textColor="#102A43" android:textSize="22sp" android:textStyle="bold"/>
        <TextView android:id="@+id/persianCalendar" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:text="تقویم فارسی" android:textColor="#B58F00" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:singleLine="true"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ready" android:textColor="#8BA6BC" android:textSize="12sp"/>
    </LinearLayout>

    <LinearLayout android:id="@+id/tvTicker" android:layout_width="match_parent" android:layout_height="102dp" android:orientation="vertical" android:background="#101B27" android:padding="3dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/tvReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="11sp" android:gravity="center"/><TextView android:id="@+id/tvTickerOriginal" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="WORLD TV NEWS • Loading…" android:textColor="#FFFFFF" android:textSize="12sp" android:gravity="center_vertical" android:singleLine="true"/>
        </LinearLayout><View android:layout_width="match_parent" android:layout_height="1dp" android:background="#33495E"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/tvPersianReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="11sp" android:gravity="center"/><TextView android:id="@+id/tvTickerPersian" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ترجمه فارسی در حال آماده‌سازی…" android:textColor="#FFD43B" android:textSize="12sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/>
        </LinearLayout><LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal">
            <Button android:id="@+id/tvPrev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="PREV" android:textSize="8sp"/>
            <Button android:id="@+id/tvPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="PAUSE" android:textSize="8sp"/>
            <Button android:id="@+id/tvStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="STOP" android:textSize="8sp"/>
            <Button android:id="@+id/tvNext" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="NEXT" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/webTicker" android:layout_width="match_parent" android:layout_height="90dp" android:orientation="vertical" android:background="#0D1722" android:padding="2dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="15dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/webReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="10sp" android:gravity="center"/><TextView android:id="@+id/webTickerTitle" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="WEB NEWS • Loading…" android:textColor="#7FD6FF" android:textSize="9sp" android:gravity="center_vertical" android:singleLine="true"/>
        </LinearLayout><TextView android:id="@+id/webTickerText" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="خبرهای صفحه اول وب‌سایت‌ها در حال دریافت…" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center_vertical" android:singleLine="true"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:orientation="horizontal">
            <Button android:id="@+id/webPrev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="PREV" android:textSize="8sp"/>
            <Button android:id="@+id/webPause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="PAUSE" android:textSize="8sp"/>
            <Button android:id="@+id/webStop" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="STOP" android:textSize="8sp"/>
            <Button android:id="@+id/webNext" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_orange_selector" android:text="NEXT" android:textSize="8sp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/publicInfoTicker" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="#101B27" android:padding="2dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#0D1722" android:padding="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/iranReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="ایران • هواشناسی و زمین‌لرزه +۴" android:textColor="#7FD6FF" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/></LinearLayout>
            <TextView android:id="@+id/publicIran" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="در حال دریافت…" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33495E"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#0D1722" android:padding="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/worldReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="جهان • زمین‌لرزه +۵" android:textColor="#7FD6FF" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/></LinearLayout>
            <TextView android:id="@+id/publicWorld" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="در حال دریافت…" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true"/>
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#33495E"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#0D1722" android:padding="3dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="18dp" android:orientation="horizontal" android:gravity="center_vertical"><TextView android:id="@+id/economyReady" android:layout_width="16dp" android:layout_height="match_parent" android:text="●" android:textColor="#69B34C" android:textSize="9sp" android:gravity="center"/><TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="اقتصاد • یارانه و معیشت" android:textColor="#FFB74D" android:textStyle="bold" android:textSize="10sp" android:gravity="center"/></LinearLayout>
            <TextView android:id="@+id/publicEconomy" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="در حال دریافت…" android:textColor="#FFFFFF" android:textSize="10sp" android:gravity="center_vertical" android:singleLine="true" android:textDirection="rtl"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:layout_marginTop="4dp" android:layout_marginBottom="4dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#071525" android:padding="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="CUSTOM RADIO" android:textColor="#39B9FF" android:textStyle="bold" android:gravity="center" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"><Button android:id="@+id/customUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▲"/><Button android:id="@+id/customDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▼"/></LinearLayout>
            <ListView android:background="@drawable/radio_list_bg" android:id="@+id/customList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#173A57" android:dividerHeight="1dp"/>
        </LinearLayout>
        <Space android:layout_width="4dp" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#071525" android:padding="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="IRAN RADIO" android:textColor="#39B9FF" android:textStyle="bold" android:gravity="center" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"><Button android:id="@+id/iranUp" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▲"/><Button android:id="@+id/iranDown" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/button_cyan_selector" android:text="▼"/></LinearLayout>
            <ListView android:background="@drawable/radio_list_bg" android:id="@+id/iranList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#173A57" android:dividerHeight="1dp"/>
        </LinearLayout>
        <Space android:layout_width="4dp" android:layout_height="match_parent"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#071525" android:padding="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="WORLD RADIO" android:textColor="#39B9FF" android:textStyle="bold" android:gravity="center" android:textSize="12sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="30dp"><Spinner android:id="@+id/regionSpinner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/><Spinner android:id="@+id/countrySpinner" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.25"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="60dp"><EditText android:id="@+id/search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:hint="Search country / station" android:textColor="#FFFFFF" android:textColorHint="#71879C" android:singleLine="true"/><ImageButton android:id="@+id/searchButton" android:layout_width="58dp" android:layout_height="match_parent" android:src="@drawable/ic_search" android:contentDescription="جستجو" android:scaleType="centerInside" android:padding="10dp" android:background="@drawable/button_green_selector"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"><Button android:id="@+id/saveList" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SAVE" android:textSize="10sp" android:background="@drawable/button_orange_selector"/><Button android:id="@+id/favorites" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="★ FAV" android:textSize="10sp" android:background="@drawable/button_orange_selector"/></LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp"><Button android:id="@+id/importButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="IMPORT" android:textSize="10sp" android:background="@drawable/button_purple_selector"/><Button android:id="@+id/savedListsButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="SAVED" android:textSize="10sp" android:background="@drawable/button_purple_selector"/></LinearLayout>
            <ListView android:background="@drawable/radio_list_bg" android:id="@+id/worldList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#173A57" android:dividerHeight="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:orientation="horizontal" android:background="#06111D" android:padding="2dp">
        <LinearLayout android:layout_width="184dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="#06111D">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="kbps" android:textColor="#39B9FF" android:textStyle="bold" android:gravity="center"/>
            <com.fast.radio.VerticalRulerView android:id="@+id/qualityRuler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
            <TextView android:id="@+id/qualityValue" android:layout_width="match_parent" android:layout_height="30dp" android:text="15 kbps" android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold" android:gravity="center"/>
        </LinearLayout>
        <LinearLayout android:layout_width="184dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_horizontal" android:background="#06111D">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="VOL" android:textColor="#39B9FF" android:textStyle="bold" android:gravity="center"/>
            <com.fast.radio.VolumeRulerView android:id="@+id/volumeRuler" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:background="#071525" android:padding="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="SPECIAL NEWS STATIONS" android:textColor="#FFE02E" android:textStyle="bold" android:gravity="center" android:textSize="12sp"/>
            <ListView android:background="@drawable/radio_list_bg" android:id="@+id/newsList" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="#665D12" android:dividerHeight="1dp"/>
        </LinearLayout>
        <LinearLayout android:layout_width="150dp" android:layout_height="match_parent" android:orientation="vertical" android:background="#0B1522" android:padding="2dp">
            <TextView android:layout_width="match_parent" android:layout_height="22dp" android:text="مصرف رادیو / 1 دقیقه" android:textColor="#FF9B22" android:textStyle="bold" android:gravity="center" android:textSize="11sp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/usagePerMinute" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:text="0.0 KB/min • 0.000 MB/min" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center"/>
                <TextView android:id="@+id/usageTimer" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.65" android:text="00:00" android:textColor="#FFB74D" android:textSize="15sp" android:textStyle="bold" android:gravity="center"/>
            </LinearLayout>
            <View android:id="@+id/usageLine" android:layout_width="match_parent" android:layout_height="8dp" android:background="#FF7A00"/>
            <TextView android:layout_width="match_parent" android:layout_height="24dp" android:text="برآورد بر اساس bitrate" android:textColor="#8BA6BC" android:textSize="10sp" android:gravity="center"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="#06111D" android:padding="5dp">
        <com.fast.radio.AudioDanceView android:id="@+id/audioDance" android:layout_width="52dp" android:layout_height="match_parent" android:layout_marginEnd="2dp" android:padding="3dp"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.8" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="2dp"><TextView android:id="@+id/nowPlaying" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.15" android:text="No station selected" android:textColor="#FFFFFF" android:textSize="14sp" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end"/><TextView android:id="@+id/streamKbps" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="Stream: -- kbps" android:textColor="#39B9FF" android:textSize="13sp" android:textStyle="bold" android:gravity="center_vertical"/><TextView android:id="@+id/usage12h" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:text="12 ساعت: -- MB" android:textColor="#FFB74D" android:textSize="12sp" android:gravity="center_vertical"/></LinearLayout>
        <FrameLayout android:layout_width="82dp" android:layout_height="match_parent"><Button android:id="@+id/play" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/button_outline_green" android:text="PLAY"/><View android:id="@+id/playLight" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="#22CC44" android:visibility="gone"/></FrameLayout><Button android:id="@+id/stop" android:layout_width="82dp" android:layout_height="match_parent" android:background="@drawable/button_outline_orange" android:text="STOP"/><FrameLayout android:layout_width="82dp" android:layout_height="match_parent"><Button android:id="@+id/record" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/button_outline_red" android:text="REC"/><View android:id="@+id/recordLight" android:layout_width="9dp" android:layout_height="9dp" android:layout_gravity="top|end" android:layout_margin="6dp" android:background="#FF3333" android:visibility="gone"/></FrameLayout><Button android:id="@+id/equalizer" android:layout_width="92dp" android:layout_height="match_parent" android:background="@drawable/button_outline_cyan" android:text="EQ"/><Button android:id="@+id/fav" android:layout_width="60dp" android:layout_height="match_parent" android:background="@drawable/button_outline_yellow" android:text="★"/>
    </LinearLayout>
</LinearLayout>
